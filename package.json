{
  "name": "opencode-file-widget",
  "version": "1.0.3",
  "description": "OpenCode V2 file widget: upload local files, download server files with /download, and manage transfer settings and history.",
  "type": "module",
  "license": "MIT",
  "author": "guzongbo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guzongbo/opencode-file-widget.git"
  },
  "homepage": "https://github.com/guzongbo/opencode-file-widget#readme",
  "bugs": {
    "url": "https://github.com/guzongbo/opencode-file-widget/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "tui",
    "file-transfer",
    "upload",
    "download"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
